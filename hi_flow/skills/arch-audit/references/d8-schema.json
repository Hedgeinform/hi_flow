{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hi_flow/skills/arch-audit/references/d8-schema.json",
  "title": "D8 Audit-Report Schema",
  "description": "JSON Schema for audit-report.json produced by hi_flow:arch-audit. Version 1.2.",
  "type": "object",
  "required": ["metadata", "findings", "metrics"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["audit_sha", "schema_version"],
      "properties": {
        "audit_sha": {
          "type": "string",
          "description": "Git commit hash on which audit was run. Used by arch-redesign for freshness check."
        },
        "schema_version": {
          "type": "string",
          "enum": ["1.1", "1.2"],
          "default": "1.2",
          "description": "Supported D8 schema version. Current producer: 1.2; 1.1 remains readable for legacy reports."
        },
        "audit_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of audit run. Optional, used for debug and session log."
        },
        "audit_tooling_version": {
          "type": "string",
          "description": "Version string of audit tooling (e.g., 'typescript-depcruise (16.3.0)'). Optional, helps interpret rule sets behind the run."
        },
        "project_name": {
          "type": "string",
          "minLength": 1,
          "description": "Project name rendered in the operator-facing report header."
        },
        "module_root": {
          "type": "string",
          "minLength": 1,
          "description": "Relative source root used to derive module ids."
        },
        "parsing_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "error": { "type": "string" }
            },
            "required": ["file", "error"]
          }
        },
        "operator_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Deterministic notes about explicit project overrides, parsing gaps, and suppression effects."
        },
        "known_rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(baseline|project):[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true,
          "description": "Exact baseline and project rule registry used by Phase 1 and rechecked before Phase 2 rendering."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "schema_version": { "const": "1.2" } },
            "required": ["schema_version"]
          },
          "then": {
            "required": ["project_name", "module_root", "known_rule_ids"]
          }
        }
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule_id", "type", "severity", "source", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable identifier for the finding."
          },
          "rule_id": {
            "type": "string",
            "pattern": "^(baseline|project):[a-z0-9][a-z0-9-]*$",
            "description": "Canonical namespaced cross-reference to the baseline or project rule whose violation is recorded."
          },
          "type": {
            "type": "string",
            "enum": ["boundary", "cycle", "sdp", "coupling", "nccd"],
            "description": "Violation type."
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
            "description": "Normalized D8 severity. Depcruise native severities (error/warn/info) are mapped to this enum by the adapter before writing to audit-report.json."
          },
          "source": {
            "type": "object",
            "properties": {
              "module": { "type": "string" },
              "file":   { "type": "string" }
            },
            "additionalProperties": false,
            "required": ["module", "file"]
          },
          "target": {
            "type": "object",
            "properties": {
              "module": { "type": "string" },
              "file":   { "type": "string" }
            },
            "additionalProperties": false,
            "required": ["module", "file"]
          },
          "reason": {
            "type": "object",
            "required": ["principle", "explanation"],
            "properties": {
              "principle": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Canonical principle id from D9 library at hi_flow/references/architectural-principles.md."
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "description": "Free-form formulation invoking the principle in concrete terms."
              }
            },
            "additionalProperties": false
          },
          "extras": {
            "type": "object",
            "description": "Type-specific extras: ordered module members for cycles; external_target plus sdk for external boundaries; detector details for other findings."
          }
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "required": ["per_module", "nccd", "nccd_threshold", "severity_counts", "dep_graph"],
      "properties": {
        "per_module": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["Ca", "Ce", "I", "LOC"],
            "properties": {
              "Ca":  { "type": "number", "description": "Afferent coupling — incoming dependencies." },
              "Ce":  { "type": "number", "description": "Efferent coupling — outgoing dependencies." },
              "I":   { "type": "number", "minimum": 0, "maximum": 1, "description": "Instability metric, 0..1." },
              "A":   { "type": "number", "minimum": 0, "maximum": 1, "description": "Abstractness metric, 0..1." },
              "D":   { "type": "number", "description": "Distance from the main sequence." },
              "LOC": { "type": "integer", "minimum": 0, "description": "Physical lines across audited source files assigned to the module." }
            }
          }
        },
        "nccd": {
          "type": "number",
          "description": "Normalized Cumulative Component Dependency metric."
        },
        "nccd_threshold": {
          "type": "number",
          "description": "Project-configured NCCD threshold (default 1.0)."
        },
        "severity_counts": {
          "type": "object",
          "required": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
          "properties": {
            "CRITICAL": { "type": "integer", "minimum": 0 },
            "HIGH":     { "type": "integer", "minimum": 0 },
            "MEDIUM":   { "type": "integer", "minimum": 0 },
            "LOW":      { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "dep_graph": {
          "type": "object",
          "description": "Module dependency graph as adjacency list, e.g., { 'moduleA': ['moduleB', 'moduleC'], ... }.",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
